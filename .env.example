# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/nimbusboard
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your-256-bit-secret-key-here

# OpenAI / Gemini
OPENAI_API_KEY=your-api-key-here

# CORS (optional)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional)
REDIS_ENABLED=false

# AI mock mode — returns sample diagrams without calling Groq (for local dev)
AI_MOCK_ENABLED=true

# When Groq rejects the API key, return sample diagrams instead of 502 (default: true)
AI_MOCK_FALLBACK=true

# Board invite emails (prefer Brevo API key; SMTP is fallback)
FRONTEND_URL=http://localhost:5173
MAIL_ENABLED=true
MAIL_FROM=verified-sender@yourdomain.com
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Optional SMTP fallback (xsmtpsib- key, not the API key)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-login@smtp-brevo.com
MAIL_PASSWORD=xsmtpsib-your-smtp-key
